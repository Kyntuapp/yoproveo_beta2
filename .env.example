# Supabase (existentes en el proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (si aplica)
NEXT_PUBLIC_MP_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Nicanor - correo operativo (solo servidor; nunca exponer al frontend)
# ---------------------------------------------------------------------------
NICANOR_EMAIL=nicanor@kyntu.cl
NICANOR_EMAIL_PASSWORD=

NICANOR_IMAP_HOST=mail.kyntu.cl
NICANOR_IMAP_PORT=993
NICANOR_SMTP_HOST=mail.kyntu.cl
NICANOR_SMTP_PORT=465

# Destinatario SOLO para prueba manual de envío (npm run test:nicanor-mail -- --send)
NICANOR_EMAIL_TEST_TO=

# Opcional
# NICANOR_MAIL_TIMEOUT_MS=20000
# NICANOR_MAIL_DEBUG=1

# Inbox Nicanor: persistencia (supabase por defecto). "file" solo desarrollo local
# sin aplicar la migración. No usar "file" en producción.
# NICANOR_INBOX_STORE=supabase

# MCP privado de Nicanor (solo servidor). Nunca poner el token en URLs.
# Authorization: Bearer <NICANOR_MCP_TOKEN>
NICANOR_MCP_TOKEN=
